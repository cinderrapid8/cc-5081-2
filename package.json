{
  "name": "attribute-evaluation-service",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Rule-driven attribute evaluation service with source provenance",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "scenarios": "tsx scripts/scenarios.ts",
    "start": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
